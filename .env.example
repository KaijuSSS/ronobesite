# Скопируйте этот файл в .env.local и заполните значения.
# .env.local не попадает в Git.

# Project URL из Supabase: Project Settings → API (или Data API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный ключ anon (или publishable key, начинается с sb_publishable_).
# Он предназначен для браузера: доступ к данным ограничивают политики RLS.
# НИКОГДА не указывайте здесь service_role / secret key.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Путь, по которому будет открываться сайт. Локально — "/".
# Для GitHub Pages — "/<имя-репозитория>/", например "/ranobesite/".
VITE_BASE_PATH=/
